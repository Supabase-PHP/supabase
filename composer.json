{
    "name": "supabasephp/supabase",
    "description": "Supabase SDK for PHP.",
    "keywords": [
        "supabase",
        "supabasephp",
        "client",
        "sdk"
    ],
    "type": "library",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Supabase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Supabase\\Tests\\": "tests/"
        }
    },
    "support": {
        "source": "https://github.com/Supabase-PHP/supabase/releases",
        "issues": "https://github.com/Supabase-PHP/supabase/issues"
    },
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com",
            "role": "Developer"
        }
    ],
    "funding": [
        {
            "type": "Open Collective",
            "url": "https://opencollective.com/CodeWithSushil"
        },
        {
            "type": "Github Sponsors",
            "url": "https://github.com/sponsors/CodeWithSushil"
        }
    ],
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
